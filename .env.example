# Copy this file to `.env` and fill in real values. `.env` is ignored by Git: secrets never enter the repository.
# Each variable is added by the Jira issue that first needs it.

# ---- Database (JAR-4) ----
# DATABASE_URL=postgresql+asyncpg://jarvis:change-me@localhost:5432/jarvis

# ---- Auth (JAR-6) ----
# JWT_SECRET=generate-a-long-random-value

# ---- AI providers (JAR-9) ----
# OLLAMA_BASE_URL=http://localhost:11434
# GEMINI_API_KEY=
